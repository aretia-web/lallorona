---
/**
 * Marca provisional: lágrima + nombre en gótica.
 * Cuando el estudio facilite su logotipo en SVG, sustituir este componente.
 */
import Icon from './Icon.astro';
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>
  <Icon name="drop" class="wordmark__drop" />
  <span class="wordmark__name">La Llorona</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark--sm {
    font-size: 1.65rem;
  }

  .wordmark--lg {
    font-size: var(--step-4);
  }

  .wordmark__drop {
    width: 0.42em;
    height: auto;
    color: var(--tear);
    transform: translateY(-0.04em);
  }

  .wordmark__name {
    letter-spacing: 0.005em;
  }
</style>
