---
import { site } from '../data/site';
import Icon from './Icon.astro';

// Texto provisional: pendiente de aprobación por el estudio.
const principles = [
  { title: 'Escuchar', text: 'Nos cuentas la idea, una referencia o solo la sensación que buscas. Con eso basta para empezar.' },
  { title: 'Dibujar para ti', text: 'El diseño se adapta a tu zona, a tu tamaño y a cómo lo vas a llevar, no a un catálogo.' },
  { title: 'Elegir a quién', text: 'Varios residentes, varios estilos. Te orientamos hacia la mano que mejor encaja con tu idea.' },
];
---

<section class="section paper manifesto" id="nosotros" aria-labelledby="manifiesto-title">
  <svg class="big-drop" viewBox="0 0 24 32" aria-hidden="true" focusable="false">
    <path d="M12 0.6S0.6 14.4 0.6 20.6A11.4 11 0 0 0 12 31.4a11.4 11 0 0 0 11.4-10.8C23.4 14.4 12 .6 12 .6Z" />
  </svg>

  <div class="wrap">
    <p class="kicker label">
      <span class="num">03</span> La casa
      {site.showDraftMarks && <span class="draft-chip">Texto provisional</span>}
    </p>

    <div class="layout">
      <h2 class="h2 quote" id="manifiesto-title" data-reveal>
        Primero se habla. <span>Luego se dibuja.</span>
      </h2>

      <div class="body">
        <p class="lede" data-reveal>
          No hay dos tatuajes iguales porque no hay dos personas iguales. Antes de tocar la piel escuchamos qué quieres
          llevar contigo y lo convertimos en un diseño que sea tuyo de verdad.
        </p>

        <ol class="principles" role="list">
          {
            principles.map((p, i) => (
              <li data-reveal style={`--delay:${i * 0.08}s`}>
                <span class="label num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="h3">{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <p class="sign label" aria-hidden="true"><Icon name="star" /> La Llorona <Icon name="star" /></p>
  </div>
</section>

<style>
  .manifesto {
    overflow: hidden;
  }

  .big-drop {
    position: absolute;
    right: -6vw;
    bottom: -14vw;
    width: clamp(16rem, 42vw, 40rem);
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.08;
    opacity: 0.22;
    pointer-events: none;
  }

  .layout {
    display: grid;
    gap: var(--space-xl);
    position: relative;
  }

  .quote span {
    display: block;
    color: var(--tear-deep);
  }

  .body {
    display: grid;
    gap: var(--space-l);
  }

  .principles {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .principles li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-border);
  }

  .principles .num {
    color: #7a5431;
    padding-top: 0.5rem;
  }

  .principles p {
    margin-top: 0.4rem;
    max-width: 44ch;
    color: var(--color-muted);
  }

  .sign {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-xl);
    color: #7a5431;
    position: relative;
  }

  .sign :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .quote {
      grid-column: 1 / 7;
      position: sticky;
      top: calc(var(--header-h) + var(--space-l));
      align-self: start;
    }
    .body {
      grid-column: 8 / -1;
      padding-top: 1rem;
    }
  }
</style>
